generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Occurrence {
  id        Int      @id @default(autoincrement())
  titulo    String
  descricao String
  categoria String
  status    String
  latitude  Float
  longitude Float
  imagem    String?
  autor     String?
  userId    String?
  createdAt DateTime @default(now())
}