generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())

  occurrences Occurrence[]
}

model Occurrence {
  id        Int      @id @default(autoincrement())
  titulo    String
  descricao String
  categoria String
  status    String
  latitude  Float
  longitude Float
  imagem    String?
  autor     String?
  userId    Int?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}