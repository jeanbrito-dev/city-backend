generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  createdAt DateTime @default(now())

  occurrences Occurrence[]
  comments    Comment[]
  replies     Reply[]
  likes       Like[]
}

model Occurrence {
  id        Int      @id @default(autoincrement())
  titulo    String
  descricao String   @db.LongText
  categoria String
  status    String   @default("pendente")
  latitude  Float
  longitude Float
  imagem    String?
  autor     String?
  userId    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  comments Comment[]
  likes    Like[]
}

model Comment {
  id           Int      @id @default(autoincrement())
  texto        String
  autor        String?
  userId       Int?
  occurrenceId Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  occurrence Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  replies    Reply[]
}

model Reply {
  id        Int      @id @default(autoincrement())
  texto     String   @db.LongText
  autor     String?
  userId    Int?
  commentId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
}

model Like {
  id           Int      @id @default(autoincrement())
  userId       Int
  occurrenceId Int
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  occurrence Occurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)

  @@unique([userId, occurrenceId])
}